# ---- Server ----
PORT=5000
NODE_ENV=development

# ---- Database (local MongoDB) ----
# Make sure MongoDB is running locally. Default local URI:
MONGO_URI=mongodb://127.0.0.1:27017/campus_bond

# ---- Auth ----
# Use a long random string. Generate one with:  node -e "console.log(require('crypto').randomBytes(48).toString('hex'))"
JWT_SECRET=replace_this_with_a_long_random_secret
JWT_EXPIRES_IN=30d

# ---- Campus email verification ----
# Only emails ending with this domain can register. Set to your college domain.
# Leave blank to allow ANY email during development.
ALLOWED_EMAIL_DOMAIN=

# OTP validity in minutes
OTP_EXPIRES_MINUTES=10

# ---- Email (SMTP) ----
# If these are left blank, OTP codes are printed to the server console (dev mode).
# For Gmail: create an "App Password" (not your normal password) and use it here.
SMTP_HOST=
SMTP_PORT=587
SMTP_USER=
SMTP_PASS=
SMTP_FROM="Campus Bond <no-reply@campusbond.app>"
