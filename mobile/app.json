{
  "expo": {
    "name": "Campus Bond",
    "slug": "campus-bond",
    "version": "1.0.0",
    "orientation": "portrait",
    "icon": "./assets/icon.png",
    "userInterfaceStyle": "light",
    "ios": {
      "supportsTablet": true
    },
    "android": {
      "adaptiveIcon": {
        "backgroundColor": "#E6F4FE",
        "foregroundImage": "./assets/android-icon-foreground.png",
        "backgroundImage": "./assets/android-icon-background.png",
        "monochromeImage": "./assets/android-icon-monochrome.png"
      }
    },
    "web": {
      "favicon": "./assets/favicon.png"
    },
    "plugins": [
      "expo-secure-store",
      "expo-font",
      [
        "expo-image-picker",
        {
          "photosPermission": "Campus Bond needs access to your photos so you can add a picture to a lost & found or marketplace post.",
          "cameraPermission": "Campus Bond needs camera access so you can take a photo for a lost & found or marketplace post."
        }
      ],
      "expo-video",
      ["expo-status-bar", { "style": "dark" }]
    ]
  }
}
