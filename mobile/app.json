{
  "expo": {
    "name": "Campus Bond",
    "slug": "campus-bond",
    "version": "1.0.0",
    "orientation": "portrait",
    "icon": "./assets/icon.png",
    "userInterfaceStyle": "light",
    "ios": {
      "supportsTablet": true
    },
    "android": {
      "adaptiveIcon": {
        "backgroundColor": "#15532E",
        "foregroundImage": "./assets/android-icon-foreground.png",
        "backgroundImage": "./assets/android-icon-background.png",
        "monochromeImage": "./assets/android-icon-monochrome.png"
      },
      "package": "com.heynmn.campusbond",
      "permissions": [
        "android.permission.RECORD_AUDIO"
      ],
      "softwareKeyboardLayoutMode": "resize"
    },
    "web": {
      "favicon": "./assets/favicon.png"
    },
    "plugins": [
      "expo-secure-store",
      "expo-font",
      [
        "expo-image-picker",
        {
          "photosPermission": "Campus Bond needs access to your photos so you can add a picture to a lost & found or marketplace post.",
          "cameraPermission": "Campus Bond needs camera access so you can take a photo for a lost & found or marketplace post."
        }
      ],
      "expo-video",
      [
        "expo-status-bar",
        {
          "style": "dark"
        }
      ],
      [
        "expo-splash-screen",
        {
          "image": "./assets/splash-icon.png",
          "imageWidth": 150,
          "resizeMode": "contain",
          "backgroundColor": "#15532E"
        }
      ]
    ],
    "owner": "zitesh",
    "extra": {
      "expo-status-bar": {
        "style": "dark"
      },
      "eas": {
        "projectId": "dc0c85a7-e502-4dd1-99b4-16b03bd931c9"
      }
    }
  }
}
